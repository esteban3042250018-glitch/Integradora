MICROSOFT_AUTH_API=your-microsoft-entra-client-id

# PostgreSQL is used by database-backed administration features.
# Set this to the shared server hostname or IP (not localhost for remote use).
POSTGRES_HOST=db.example.org
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=integradora
# Optional TLS settings for remote PostgreSQL servers.
POSTGRES_SSLMODE=require
# For certificate verification, use verify-full and set the trusted CA path.
# POSTGRES_SSLROOTCERT=C:\path\to\root.crt
# Optional client certificate authentication:
# POSTGRES_SSLCERT=C:\path\to\client.crt
# POSTGRES_SSLKEY=C:\path\to\client.key

# Optional shared mailbox and mail filtering settings.
CVDR_MAILBOX_EMAIL=
CVDR_MAX_MESSAGES=300
CVDR_FOLIO_REGEX=

# Optional override for the default Documents\GestionInstitucional\Oficios folder.
# GESTION_INSTITUCIONAL_DOCUMENTS_DIR=C:\Users\your-user\Documents\GestionInstitucional\Oficios

# SFTP destination for generated PDF files.
SFTP_HOST=sftp.example.org
SFTP_PORT=22
SFTP_USER=your-sftp-user
SFTP_PASSWORD=your-sftp-password
SFTP_REMOTE_DIR=/srv/gestion-institucional/oficios
# Pin the server's SHA256 fingerprint, e.g. SHA256:base64-fingerprint.
SFTP_HOST_KEY_FINGERPRINT=SHA256:your-server-host-key-fingerprint
