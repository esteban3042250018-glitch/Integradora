MICROSOFT_AUTH_API=your-microsoft-entra-client-id

# PostgreSQL is required to register the generated PDF paths.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=integradora

# SSH/SFTP server where generated PDFs are stored.
SFTP_HOST=your-sftp-host
SFTP_PORT=22
SFTP_USER=your-sftp-user
SFTP_PASSWORD=your-sftp-password
SFTP_REMOTE_DIR=/path/to/oficios
SFTP_HOST_KEY_FINGERPRINT=SHA256:replace-with-verified-ed25519-fingerprint

# Optional override for the default Documents\GestionInstitucional\Oficios folder.
# GESTION_INSTITUCIONAL_DOCUMENTS_DIR=C:\Users\your-user\Documents\GestionInstitucional\Oficios
