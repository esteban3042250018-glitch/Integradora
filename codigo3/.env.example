MICROSOFT_AUTH_API=your-microsoft-entra-client-id

# PostgreSQL local de pruebas de cada tester.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=integradora

# Optional override for the default Documents\GestionInstitucional\Oficios folder.
# GESTION_INSTITUCIONAL_DOCUMENTS_DIR=C:\Users\your-user\Documents\GestionInstitucional\Oficios
